{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validator for misp-objects",
  "$id": "https://www.github.com/MISP/misp-objects/schema.json",
  "definitions": {
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "format": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "opposite": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "name",
        "description",
        "format"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer"
    },
    "values": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/value"
      }
    },
    "description": {
      "type": "string"
    },
    "uuid": {
      "type": "string"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "values",
    "description",
    "uuid",
    "name"
  ]
}
